{
  "name": "omniplan",
  "version": "4.10.3",
  "description": "OmniPlan 4 clone — project management with Gantt, resources, Omni Automation, and OmniFocus bridge",
  "type": "module",
  "bin": {
    "omniplan": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && vite build --config web/vite.config.ts",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/index.ts",
    "omniplan": "tsx src/cli/index.ts",
    "test": "tsx --test test/**/*.test.ts",
    "seed": "tsx src/cli/index.ts seed"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "zustand": "^5.0.6"
  }
}
